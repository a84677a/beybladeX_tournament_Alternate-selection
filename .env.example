# 候補系統 — Script Properties 設定說明
# 實際值請在 Google Apps Script 編輯器 → 專案設定 → Script properties 設定
# 請勿將真實 PIN 提交至版本控制

# === 必填 ===
SPREADSHEET_ID=your-google-sheet-id-here
ADMIN_PIN=your-admin-pin-here

# === Session ===
SESSION_TTL_HOURS=12

# === PIN Rate Limit ===
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=5

# === 預設 Staff PIN ===
# 由 setupWaitlistSystem() 寫入 Settings（預設 0313）
# 部署後請於 Admin 後台立即修改
